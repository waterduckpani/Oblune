---
import Moon from './Moon.astro';
import { PHASES, type Phase } from '../lib/phase';
import { projects, categoryOf } from '../data/projects';

const n = (i: number) => String(i + 1).padStart(2, '0');
const STAGES: Phase[] = ['crescent', 'half', 'gibbous', 'full'];
---
<!--
  The work: eight cards in two columns, the right column set lower so the grid reads as a sequence,
  not a table. Each cover is drawn on the stage (it bends with the scroll); the <img> here is the
  fallback and the source of truth for layout. Hovering a card shows how far along it is: the four
  phases a project goes through, lit up to the one it has reached, and that phase's name.
-->
<section id="work" class="work" data-work aria-labelledby="work-title">
  <div class="container work__head">
    <h2 class="work__title" id="work-title" data-words>Selected work</h2>
    <p class="work__lede" data-words>
      Eight products from 2026. Two iOS apps, two AI tools, three web platforms and a store for a
      client, each one designed and built end to end.
    </p>
  </div>

  <div class="container work__body">
  <ol class="work__grid">
    {projects.map((p, i) => (
      <li class="card" data-card={i} id={p.slug} data-lit={PHASES[p.phase].lit}>
        <a class="card__link" href={`/work/${p.slug}`} data-cursor="Case study" data-card-link={i}>
          <div class="card__media" data-card-media data-src={`${p.image.base}-1400.webp`} data-src-small={`${p.image.base}-800.webp`} data-bg={p.stage.bg}>
            <img src={`${p.image.base}-1400.webp`} srcset={`${p.image.base}-800.webp 800w, ${p.image.base}-1400.webp 1400w, ${p.image.base}-2400.webp 2400w`}
              sizes="(max-width: 860px) 92vw, 46vw" alt={p.image.alt} width="1400" height="875" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority="low" decoding="async" />
            <span class="card__phase" aria-hidden="true">
              <span class="card__steps">{STAGES.map((st, j) => (
                <span class:list={['card__step', { 'is-on': j <= STAGES.indexOf(p.phase) }]} style={`--j:${j}`}><Moon lit={PHASES[st].lit} size={14} /></span>
              ))}</span>
              <span class="card__phase-label">{PHASES[p.phase].label}</span>
            </span>
          </div>
          <div class="card__meta">
            <p class="card__tags"><span>{n(i)}</span>{p.kind}<i aria-hidden="true">/</i>{categoryOf(p).label}<i aria-hidden="true">/</i>{p.context.label}</p>
            <h3 class="card__name" translate="no"><span class="card__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M3 12h17M13 5l7 7-7 7" /></svg></span>{p.name}</h3>
            <p class="card__line">{p.line}</p>
            <p class="card__status"><Moon lit={PHASES[p.phase].lit} size={13} label={PHASES[p.phase].label} /><span>{p.statusNote}</span></p>
          </div>
        </a>
      </li>
    ))}
  </ol>
  </div>
</section>

<style>
  .work { position: relative; z-index: 3; color: var(--ink); padding-block: clamp(160px, 24vh, 280px) clamp(140px, 22vh, 260px); }
  .work__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
  .work__title { grid-column: 1 / span 8; font-size: clamp(56px, 8.6vw, 168px); line-height: 0.88; letter-spacing: -0.065em; font-weight: 520; margin-left: -0.05em; padding-bottom: 0.08em; }
  .work__lede { grid-column: 9 / -1; font-size: clamp(16px, 1.1vw, 19px); line-height: 1.45; color: var(--ink-2); max-width: 34ch; padding-bottom: 1.4em; text-wrap: pretty; }

  .work__body { position: relative; --gap: clamp(28px, 7vw, 132px); }
  .work__grid {
    margin-top: clamp(56px, 8vh, 110px);
    display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--gap); row-gap: clamp(72px, 10vh, 130px);
    padding-bottom: clamp(80px, 14vh, 180px);
  }
  /* the right column sits lower: the eye reads down a sequence instead of across a table */
  .card:nth-child(even) { transform: translateY(clamp(80px, 14vh, 180px)); }

  .card__link { display: block; }
  .card__media { position: relative; aspect-ratio: 16 / 10; border-radius: clamp(14px, 1.4vw, 22px); overflow: hidden; background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-out), opacity 0.4s; }
  .card__link:hover .card__media img { transform: scale(1.03); }
  /* once the stage draws the cover, the DOM image steps aside (it stays for layout, search and print) */
  .card__media:global(.is-gl) { background: transparent; }
  .card__media:global(.is-gl) img { opacity: 0; }

  /* on hover: where the project is in its life, the four phases lit up to the one it has reached */
  .card__phase {
    position: absolute; left: clamp(12px, 1.2vw, 18px); bottom: clamp(12px, 1.2vw, 18px);
    display: inline-flex; align-items: center; gap: 12px; padding: 8px 14px 8px 10px; border-radius: 99px;
    background: rgb(16 16 18 / 0.82); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: #f4f4f2; font-size: 12.5px; font-weight: 540; letter-spacing: 0.01em; white-space: nowrap;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.35s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .card__steps { display: inline-flex; gap: 4px; }
  .card__step { display: grid; opacity: 0.22; transform: scale(0.7); transition: opacity 0.4s, transform 0.5s var(--ease-out); }
  .card__phase-label { opacity: 0; transform: translateX(-4px); transition: opacity 0.4s 0.18s, transform 0.5s 0.18s var(--ease-out); }
  .card__link:hover .card__phase, .card__link:focus-visible .card__phase { opacity: 1; transform: none; }
  .card__link:hover .card__step, .card__link:focus-visible .card__step { transform: none; transition-delay: calc(var(--j) * 60ms + 80ms); }
  .card__link:hover .card__step.is-on, .card__link:focus-visible .card__step.is-on { opacity: 1; }
  .card__link:hover .card__phase-label, .card__link:focus-visible .card__phase-label { opacity: 1; transform: none; }
  @media (hover: none) { .card__phase { display: none; } }
  @media (prefers-reduced-motion: reduce) { .card__phase, .card__step, .card__phase-label { transition-duration: 0.01s; transform: none; } }

  /* (as the day comes back for the studio, home.ts fades the head and the metas: they recede) */
  .card__meta { padding-top: clamp(16px, 2vh, 24px); display: grid; gap: 8px; }
  .card__tags { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.5em; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.02em; color: var(--ink-2); text-transform: uppercase; }
  .card__tags span { color: var(--ink); margin-right: 0.6em; }
  .card__tags i { font-style: normal; color: var(--ink-3); }
  .card__name {
    display: flex; align-items: center;
    font-size: clamp(32px, 3.2vw, 58px); line-height: 1; letter-spacing: -0.05em; font-weight: 540;
    margin-left: -0.04em;
  }
  .card__arrow { display: inline-grid; place-items: center; width: 0; overflow: hidden; transition: width 0.6s var(--ease-out); }
  .card__arrow svg { width: 0.72em; height: 0.72em; flex: none; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transform: translateX(-100%); transition: transform 0.6s var(--ease-out); }
  .card__link:hover .card__arrow, .card__link:focus-visible .card__arrow { width: 0.95em; }
  .card__link:hover .card__arrow svg, .card__link:focus-visible .card__arrow svg { transform: none; }
  .card__line { font-size: clamp(16px, 1.15vw, 19px); line-height: 1.4; color: var(--ink-2); max-width: 36ch; }
  .card__status { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 560; color: var(--ink); }

  @media (max-width: 860px) {
    .work__head { grid-template-columns: 1fr; row-gap: 18px; }
    .work__title, .work__lede { grid-column: 1; padding-bottom: 0; }
    .work__title { font-size: clamp(52px, 15vw, 88px); }
    .work__grid { grid-template-columns: 1fr; row-gap: 64px; padding-bottom: 0; }
    .card:nth-child(even) { transform: none; }
  }
</style>
