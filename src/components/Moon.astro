---
// The emblem at a given phase, drawn as SVG. Used for status glyphs and the legend.
import { emblemPath } from '../lib/phase';

interface Props {
  lit: number;
  size?: number;
  class?: string;
  label?: string;
}
const { lit, size = 20, class: className, label } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="-40 -40 80 80"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <path transform="rotate(24)" fill="currentColor" fill-rule="evenodd" d={emblemPath(lit)} />
</svg>
