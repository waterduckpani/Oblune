---
import Icon from './Icon.astro';
---
<section class="hero" aria-labelledby="hero-title">

  <div class="hero__grid container">
    <button class="hero__moon" type="button" data-moon-anchor="hero" aria-label="The Oblune moon. Drag it, or use the arrow keys, to turn it through a month; press to play a whole month" aria-describedby="hero-phase" data-cursor="Drag">
      <img class="hero__fallback" src="/emblem-chrome.svg" alt="" width="320" height="320" draggable="false" />
    </button>
    <p class="hero__eyebrow meta" data-hero-foot>Oblune Studio<span class="hero__sep">/</span>Independent product studio</p>
    <p class="hero__aside meta" id="hero-phase" data-hero-foot><span class="hero__phase-dot" aria-hidden="true"></span><span data-hero-phase>Drag the moon through its month</span></p>

    <h1 class="hero__title" id="hero-title" data-hero-title>
      <span class="hero__line">I design products,</span>{' '}
      <span class="hero__line hero__line--soft">then I build them.</span>
    </h1>

    <div class="hero__foot" data-hero-foot>
      <span data-string aria-hidden="true"></span>
      <p class="hero__sub">
        Oblune is Bharat Khanna, a one-person studio in New Delhi. Apps, AI tools, websites and stores,
        designed and built end to end.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--solid" href="#work" data-magnetic>
          <span data-wave>See the work</span>
          <Icon name="arrow-down-right" class="btn__arrow" />
        </a>
        <a class="btn btn--ghost" href="#contact" data-magnetic>
          <span data-wave>Work with me</span>
          <Icon name="arrow-up-right" class="btn__arrow" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh; height: 100svh; min-height: 620px;
  }
  /* the moon is drawn by the world canvas; this is its slot and its hit area */
  .hero__moon {
    position: absolute; z-index: 2;
    width: min(31vw, 52vh); aspect-ratio: 1;
    right: calc(var(--gutter) + 10vw); top: calc(46% - min(33vw, 54vh) * 0.62);
    border: 0; padding: 0; background: none; border-radius: 50%;
    cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none;
  }
  .hero__moon:active { cursor: grabbing; }
  .hero__moon:focus-visible { outline-offset: 16px; border-radius: 50%; }
  .hero__fallback { width: 100%; height: 100%; opacity: 0; }
  :global(.no-webgl) .hero__fallback { opacity: 1; }

  .hero__grid {
    position: relative; z-index: 3; height: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto auto;
    column-gap: var(--gutter);
    padding-top: 96px; padding-bottom: clamp(28px, 4.5vh, 52px);
    pointer-events: none;
  }
  .hero__grid a, .hero__grid button, .hero__title, .hero__sub { pointer-events: auto; }
  .hero__eyebrow { grid-column: 1 / span 6; grid-row: 1; color: var(--ink); }
  /* the moon's readout: a hint until you touch it, then the phase you have turned it to */
  .hero__aside { grid-column: 7 / -1; grid-row: 1; justify-self: end; display: inline-flex; align-items: center; gap: 10px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .hero__phase-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.6; animation: hero-dot 2.4s var(--ease-in-out) infinite; }
  :global(html[data-moon-touched]) .hero__phase-dot { animation: none; opacity: 0.35; }
  @keyframes hero-dot { 0%, 100% { transform: scale(0.6); opacity: 0.25; } 50% { transform: scale(1.2); opacity: 0.8; } }
  @media (prefers-reduced-motion: reduce) { .hero__phase-dot { animation: none; } }
  .hero__sep { margin: 0 0.7em; color: var(--ink-3); }

  .hero__title {
    grid-column: 1 / -1; grid-row: 3; align-self: end;
    font-size: clamp(50px, 8.1vw, 156px);
    line-height: 0.9;
    font-weight: 560;
    letter-spacing: -0.058em;
    margin-left: -0.05em;
  }
  .hero__line { display: block; }
  .hero__line--soft { font-style: italic; font-weight: 340; letter-spacing: -0.05em; padding-left: 1.05em; }

  .hero__foot {
    grid-column: 1 / -1; grid-row: 4;
    margin-top: clamp(24px, 4vh, 44px);
    display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap;
    padding-top: 20px; position: relative;
  }
  .hero__sub { max-width: 44ch; text-wrap: pretty; font-size: clamp(16px, 1.15vw, 19px); line-height: 1.45; color: var(--ink-2); }
  .hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .hero { height: auto; min-height: 100svh; }
    .hero__grid { grid-template-rows: auto auto auto 1fr auto auto; padding-top: 84px; }
    .hero__aside { grid-column: 1 / -1; grid-row: 3; justify-self: center; align-self: start; margin: 12px 0 5svh; }
    .hero__eyebrow { grid-column: 1 / -1; }
    .hero__moon { position: relative; grid-column: 1 / -1; grid-row: 2; right: auto; top: auto; width: min(64vw, 34svh); margin: 5svh auto 0; display: block; }
    .hero__title { font-size: clamp(44px, 12.4vw, 76px); grid-row: 5; }
    .hero__foot { grid-row: 6; }
    .hero__line--soft { padding-left: 0; }
    .hero__foot { flex-direction: column; align-items: flex-start; }
  }
</style>
