---
// The way in. Browsers only let a page make sound after a click, tap or key press (a scroll does not
// count), so when sound is wanted and the browser is holding it back, the visit begins with one
// press: Enter, with sound. At the end of the loader it sits under the logo; on any other first
// load it rests over the page as a veil. Turning sound off (here or in the nav) is remembered, and
// then this never appears.
---
<div class="enter" data-enter data-on="false" data-variant="veil" role="dialog" aria-modal="true" aria-label="Enter Oblune Studio" hidden>
  <div class="enter__inner">
    <button class="enter__go" type="button" data-enter-go autofocus>
      <span class="enter__bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="enter__label">Enter</span>
      <span class="enter__k meta" aria-hidden="true">↵</span>
    </button>
    <p class="enter__note meta">Sound on. Best with headphones.</p>
    <button class="enter__quiet" type="button" data-enter-quiet>Enter without sound</button>
  </div>
</div>

<style>
  .enter {
    position: fixed; inset: 0; z-index: 52;
    display: grid; place-items: center;
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(18px) saturate(0.9);
    -webkit-backdrop-filter: blur(18px) saturate(0.9);
    opacity: 0; transition: opacity 0.7s var(--ease-out);
  }
  .enter[hidden] { display: none; }
  .enter[data-on='true'] { opacity: 1; }
  /* at the end of the loader the loader is the backdrop: only the controls show, under the logo */
  .enter[data-variant='loader'] { background: none; backdrop-filter: none; -webkit-backdrop-filter: none; place-items: end center; padding-bottom: clamp(96px, 17vh, 190px); }
  .enter__inner { display: grid; justify-items: center; gap: 16px; }
  .enter__go {
    position: relative; display: inline-flex; align-items: center; gap: 16px;
    height: 68px; padding: 0 26px 0 24px; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--ink); color: var(--bg);
    font-size: 20px; font-weight: 600; letter-spacing: -0.02em;
    box-shadow: 0 24px 60px -24px rgb(20 20 22 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.14);
    transition: transform 0.6s cubic-bezier(0.2, 1.4, 0.3, 1), box-shadow 0.4s;
    translate: 0 14px; opacity: 0;
  }
  .enter[data-on='true'] .enter__go { animation: enter-in 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
  .enter[data-on='true'] .enter__note, .enter[data-on='true'] .enter__quiet { animation: enter-fade 1s var(--ease-out) 0.35s both; }
  @keyframes enter-in { from { translate: 0 14px; opacity: 0; scale: 0.94; } to { translate: 0 0; opacity: 1; scale: 1; } }
  @keyframes enter-fade { from { opacity: 0; } to { opacity: 1; } }
  .enter__go:hover { transform: scale(1.04); box-shadow: 0 30px 70px -24px rgb(20 20 22 / 0.6), inset 0 1px 0 rgb(255 255 255 / 0.14); }
  .enter__go:active { transform: scale(0.97); }
  .enter__go::after { content: ''; position: absolute; inset: -8px; border-radius: inherit; box-shadow: 0 0 0 1px var(--ink); opacity: 0.22; animation: enter-ring 2.6s var(--ease-out) infinite; pointer-events: none; }
  @keyframes enter-ring { 0% { inset: -2px; opacity: 0.35; } 100% { inset: -22px; opacity: 0; } }
  .enter__bars { display: flex; align-items: center; gap: 3px; height: 18px; }
  .enter__bars i { width: 2.5px; height: 100%; border-radius: 2px; background: currentColor; transform-origin: 50% 50%; animation: enter-bar 1.1s var(--ease-in-out) infinite alternate; }
  .enter__bars i:nth-child(2) { animation-delay: -0.3s; }
  .enter__bars i:nth-child(3) { animation-delay: -0.75s; }
  .enter__bars i:nth-child(4) { animation-delay: -0.15s; }
  .enter__bars i:nth-child(5) { animation-delay: -0.5s; }
  @keyframes enter-bar { from { transform: scaleY(0.2); } to { transform: scaleY(1); } }
  .enter__k { color: inherit; opacity: 0.5; font-size: 13px; padding: 3px 7px; border-radius: 6px; box-shadow: inset 0 0 0 1px rgb(236 236 233 / 0.3); }
  .enter__note { color: var(--ink-2); opacity: 0; }
  .enter__quiet {
    border: 0; background: none; padding: 8px 6px; min-height: 44px; cursor: pointer; color: var(--ink-2);
    font-size: 14px; font-weight: 520; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line-strong);
    opacity: 0; transition: color 0.3s;
  }
  .enter__quiet:hover { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .enter__bars i, .enter__go::after { animation: none; }
    .enter__bars i { transform: scaleY(0.6); }
  }
</style>
