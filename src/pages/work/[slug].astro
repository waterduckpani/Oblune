---
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Moon from '../../components/Moon.astro';
import Device from '../../components/Device.astro';
import Gate from '../../components/Gate.astro';
import { projects, categoryOf, nextOf, type Project, type Shot } from '../../data/projects';
import { PHASES, emblemPath } from '../../lib/phase';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
interface Props { p: Project }
const { p } = Astro.props;
const cat = categoryOf(p);
const next = nextOf(p);
const lit = PHASES[p.phase].lit;
const tex = (n: string) => `/work/tex/${p.slug}/${n}.webp`;
const dark = p.stage.tone === 'dark';
const phones = p.shots.filter((s) => s.kind === 'phone');
const desktops = p.shots.filter((s) => s.kind === 'desktop');
// the stage: three phones fanned, or a browser with a phone in front, or (for Alfard) the terminal
const stageKind = p.slug === 'alfard' ? 'terminal' : p.shots[0]?.kind === 'desktop' ? 'pair' : 'trio';
const walkKind = p.slug === 'alfard' ? 'terminal' : p.steps.every((s) => s.desktop) ? 'pair' : 'phone';
const nextDark = next.stage.tone === 'dark';
const shadowX = (l: number) => (-2 * 48 * l).toFixed(2);
const litCol = dark ? `color-mix(in srgb, ${p.stage.glow} 72%, #ffffff)` : p.stage.bg;
const shadowCol = dark ? p.stage.bg : `color-mix(in srgb, ${p.stage.bg} 70%, #1b1c20)`;

// Every section shares one grid: its label in the left column (sticky while you read it), its
// content to the right. Numbers follow the sections this project actually has.
const order = ['brief', 'walk', 'decide', 'system', 'screens', ...(p.live?.embed ? ['live'] : []), 'code', 'now'];
const num = (k: string) => String(order.indexOf(k) + 1).padStart(2, '0');

// Screens: a wall of every screen, tilted in the product's colour, its columns drifting with the scroll.
const small = (src: string) => { const s = src.replace(/\.webp$/, '-s.webp'); return existsSync(`public${s}`) ? s : src; };
const wall = (() => {
  const pattern: Shot['kind'][] = phones.length && desktops.length
    ? ['phone', 'desktop', 'phone', 'desktop', 'phone', 'desktop']
    : phones.length ? ['phone', 'phone', 'phone', 'phone', 'phone', 'phone', 'phone'] : ['desktop', 'desktop', 'desktop', 'desktop', 'desktop'];
  const at = { phone: 0, desktop: 0 };
  return pattern.map((kind, c) => {
    const list = kind === 'phone' ? phones : desktops;
    at[kind] += c; // start each column somewhere else in the set, so neighbours differ
    return { kind, items: Array.from({ length: 4 }, () => list[at[kind]++ % list.length]) };
  });
})();

// The next case study: the page ends by becoming it. Its words match the curtain's exactly, so
// the hand-over is seamless.
const nIndex = projects.indexOf(next);
const nKicker = `Case study · ${categoryOf(next).label} · ${String(nIndex + 1).padStart(2, '0')} / ${String(projects.length).padStart(2, '0')}`;
const nLit = PHASES[next.phase].lit;
const nInk = nextDark ? '#ecece9' : '#141416';
const nBg = `radial-gradient(120% 90% at 70% 30%, ${next.stage.glow} 0%, ${next.stage.bg} 62%)`;
---
<Base
  page="case"
  title={`${p.name}: ${p.line} | Oblune Studio`}
  description={p.summary}
  image={`/work/${p.slug}-2400.webp`}
  navLabel={p.name}
  navLit={lit}
>
  <main
    id="main"
    class="cs"
    data-case={p.slug}
    data-lit={lit}
    data-live={p.live?.href ?? ''}
    data-live-label={p.live ? (p.category === 'commerce' ? 'Open the store' : p.live.host === 'pypi.org' ? 'PyPI' : 'Open the site') : ''}
    data-live-window={p.live?.embed ? 'true' : undefined}
    style={`--c-bg: ${p.stage.bg}; --c-glow: ${p.stage.glow}; --c-lit: ${litCol}; --c-shadow: ${shadowCol}; --c-ink: ${dark ? '#ecece9' : '#141416'}`}
  >
    <!-- ======================================================== hero -->
    <header class="cs-hero container">
      <div class="cs-hero__top">
        <a class="cs-back" href={`/#${p.slug}`} data-cursor="Back"><Icon name="arrow-left" class="cs-back__icon" /><span data-wave>All work</span></a>
        <p class="meta cs-crumb">Work<span>/</span>{cat.label}<span>/</span>{p.kind}</p>
      </div>
      <h1 class="cs-name" translate="no" data-cs-name style={`--len: ${p.name.length}; --wlen: ${Math.max(...p.name.split(' ').map((w) => w.length))}`}>{p.name}</h1>
      <div class="cs-hero__grid">
        <p class="cs-line" data-cs-in>{p.line}</p>
        <dl class="cs-facts" data-cs-in>
          <div><dt class="meta">Status</dt><dd class="cs-status"><Moon lit={lit} size={16} />{p.statusNote}</dd></div>
          <div><dt class="meta">For</dt><dd>{p.context.label}</dd></div>
          <div><dt class="meta">When</dt><dd>{p.timeline}</dd></div>
          <div><dt class="meta">My role</dt><dd>{p.role.join(', ')}</dd></div>
          <div class="cs-facts__wide"><dt class="meta">Built with</dt><dd>{p.stack.join(', ')}</dd></div>
        </dl>
      </div>
      <div class="cs-ctas" data-cs-in>
        {p.live && (
          <a class="btn btn--solid" href={p.live.href} target="_blank" rel="noopener" data-magnetic data-cursor="Open" data-live-open={p.live.embed ? p.slug : undefined}>
            <span data-wave>{p.live.label}</span><Icon name="arrow-up-right" class="btn__arrow" />
          </a>
        )}
        {p.command && (
          <button class="cs-cmd" type="button" data-copy={p.command} data-cursor="Copy">
            <span aria-hidden="true">$</span><code>{p.command}</code><span class="meta" data-copy-state aria-live="polite">Copy</span>
          </button>
        )}
        {p.repo && (
          <a class={`btn ${p.live ? 'btn--ghost' : 'btn--solid'}`} href="#code" data-magnetic data-cursor="Browse">
            <span data-wave>Browse the code</span><Icon name="code" class="btn__arrow" />
          </a>
        )}
        {p.repo && (
          <a class="cs-gh" href={p.repo.url} target="_blank" rel="noopener"><Icon name="github" class="cs-gh__icon" /><span data-wave>GitHub</span></a>
        )}
      </div>
    </header>

    <!-- ======================================================== stage -->
    <section class={`cs-stage cs-stage--${stageKind}`} data-tone={p.stage.tone} aria-label={p.image.alt} data-cs-stage>
      <div class="cs-stage__moon" aria-hidden="true"><svg viewBox="-54 -54 108 108" data-depth="0.12">
        <defs>
          <radialGradient id="cs-lit" cx="0.64" cy="0.34" r="0.78">
            <stop offset="0" stop-color={`color-mix(in srgb, ${litCol} 70%, #ffffff)`} />
            <stop offset="0.55" stop-color={litCol} />
            <stop offset="1" stop-color={`color-mix(in srgb, ${litCol} 82%, ${dark ? '#000000' : '#1b1c20'})`} />
          </radialGradient>
          <radialGradient id="cs-limb" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0.72" stop-color="#000" stop-opacity="0" />
            <stop offset="1" stop-color="#000" stop-opacity={dark ? 0.38 : 0.16} />
          </radialGradient>
          <filter id="cs-soft" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="3.4" /></filter>
          <clipPath id="cs-disc"><circle r="48" /></clipPath>
        </defs>
        <g transform="rotate(-24)">
          <circle r="48" fill="url(#cs-lit)" />
          <g clip-path="url(#cs-disc)"><circle r="51" cx={shadowX(lit)} fill="var(--c-shadow)" filter="url(#cs-soft)" /></g>
          <circle r="48" fill="url(#cs-limb)" />
        </g>
        <circle class="cs-stage__orbit" r="51.5" />
      </svg></div>
      <div class="cs-stage__set">
        {stageKind === 'trio' && phones.slice(0, 3).map((s, i) => (
          <div class={`cs-stage__dv cs-stage__dv--${['l', 'c', 'r'][i]}`}><div class="cs-stage__float" data-depth={[0.34, 0.2, 0.42][i]}>
            <Device kind="phone" src={s.src} alt={s.alt} eager={i === 1} sizes="(max-width: 860px) 34vw, 20vw" />
          </div></div>
        ))}
        {stageKind === 'pair' && (
          <>
            <div class="cs-stage__dv cs-stage__dv--desk"><div class="cs-stage__float" data-depth="0.18"><Device kind="desktop" src={desktops[0].src} alt={desktops[0].alt} eager sizes="(max-width: 860px) 86vw, 58vw" /></div></div>
            <div class="cs-stage__dv cs-stage__dv--phone"><div class="cs-stage__float" data-depth="0.45"><Device kind="phone" src={(phones[phones.length > 2 ? 2 : 0] ?? phones[0]).src} alt={(phones[phones.length > 2 ? 2 : 0] ?? phones[0]).alt} eager sizes="(max-width: 860px) 30vw, 16vw" /></div></div>
          </>
        )}
        {stageKind === 'terminal' && (
          <div class="cs-stage__dv cs-stage__dv--term"><div class="cs-stage__float" data-depth="0.2"><Gate id="stage" static /></div></div>
        )}
      </div>
      <p class="cs-stage__cap meta" aria-hidden="true"><span>{p.name}</span><span>{p.kind} · {p.year}</span></p>
    </section>

    <!-- ======================================================== numbers -->
    <section class="cs-sec container cs-numbers" aria-labelledby="cs-numbers-h">
      <h2 class="cs-h" id="cs-numbers-h"><span class="cs-h__n meta">00</span><span class="cs-h__t">In numbers</span></h2>
      <div class="cs-sec__body cs-metrics">
        {p.metrics.map((m) => (
          <div class="cs-metric" data-cs-rise>
            <p class="cs-metric__v"><span data-count={m.value}>{m.value}</span>{m.unit && <span class="cs-metric__u">{m.unit}</span>}</p>
            <p class="cs-metric__l">{m.label}</p>
            {m.source && <p class="cs-metric__s meta">{m.source}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- ======================================================== brief -->
    <section class="cs-sec container cs-brief" aria-labelledby="cs-brief-h" data-cs-section="The brief">
      <h2 class="cs-h" id="cs-brief-h"><span class="cs-h__n meta">{num('brief')}</span><span class="cs-h__t">The brief</span></h2>
      <div class="cs-sec__body">
        {p.brief.map((para, i) => <p class={i === 0 ? 'cs-brief__lead' : 'cs-brief__p'} data-brighten={i === 0 ? '' : undefined} data-cs-rise={i ? '' : undefined}>{para}</p>)}
      </div>
    </section>

    <!-- ======================================================== walkthrough -->
    <section class={`cs-sec container cs-walk cs-walk--${walkKind}`} aria-labelledby="cs-walk-h" data-cs-section="How it works" data-walk>
      <h2 class="cs-h" id="cs-walk-h"><span class="cs-h__n meta">{num('walk')}</span><span class="cs-h__t">How it works</span></h2>
      <ol class="cs-walk__steps">
        {p.steps.map((s, i) => (
          <li class="cs-walk__step" data-walk-step={i}>
            <span class="cs-walk__n meta">{String(i + 1).padStart(2, '0')} / {String(p.steps.length).padStart(2, '0')}</span>
            <h3 class="cs-walk__t">{s.title}</h3>
            <p class="cs-walk__x">{s.text}</p>
            {walkKind !== 'terminal' && (
              <div class="cs-walk__inline" aria-hidden="true">
                {s.desktop && <Device kind="desktop" src={tex(s.desktop)} alt="" sizes="92vw" />}
                {s.phone && !s.desktop && <Device kind="phone" src={tex(s.phone)} alt="" sizes="60vw" />}
              </div>
            )}
          </li>
        ))}
      </ol>
      <div class="cs-walk__stage">
        <div class="cs-walk__sticky">
          {walkKind === 'terminal' ? (
            <Gate id="walk" />
          ) : (
            <div class="cs-walk__frames">
              <div class="cs-walk__glow" aria-hidden="true"></div>
              {walkKind === 'pair' && (
                <div class="cs-walk__desk">
                  {p.steps.map((s, i) => s.desktop && <Device kind="desktop" src={tex(s.desktop)} alt={s.title} class="cs-walk__frame" data-walk-frame={i} sizes="50vw" />)}
                </div>
              )}
              <div class="cs-walk__phone">
                {p.steps.map((s, i) => s.phone && <Device kind="phone" src={tex(s.phone)} alt={s.title} class="cs-walk__frame" data-walk-frame={i} sizes="20vw" />)}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ======================================================== decisions -->
    <section class="cs-sec container cs-decide" aria-labelledby="cs-decide-h" data-cs-section="Decisions">
      <h2 class="cs-h" id="cs-decide-h"><span class="cs-h__n meta">{num('decide')}</span><span class="cs-h__t">Decisions that shaped it</span></h2>
      <ol class="cs-sec__body cs-decide__list">
        {p.decisions.map((d, i) => (
          <li class="cs-decide__item" data-cs-rise>
            <span class="cs-decide__n meta">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="cs-decide__t">{d.title}</h3>
            <p class="cs-decide__x">{d.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ======================================================== system -->
    <section class="cs-sec container cs-system" aria-labelledby="cs-system-h" data-cs-section="The system">
      <h2 class="cs-h" id="cs-system-h"><span class="cs-h__n meta">{num('system')}</span><span class="cs-h__t">The system, end to end</span></h2>
      <div class="cs-sec__body">
        <div class="cs-sys" data-system>
          <span class="cs-sys__rail" aria-hidden="true"><span class="cs-sys__drawn" data-system-line></span><span class="cs-sys__bead" data-system-bead><Moon lit={lit} size={18} /></span></span>
          <ol class="cs-sys__list">
            {p.flow.map((f, i) => (
              <li class="cs-sys__node" data-system-node={i}>
                <span class="cs-sys__dot" aria-hidden="true"></span>
                <span class="meta cs-sys__i">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="cs-sys__t">{f.title}</h3>
                <p class="cs-sys__x">{f.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ======================================================== screens -->
    {p.shots.length > 0 && (
      <section class="cs-wall" aria-labelledby="cs-wall-h" data-cs-section="Screens" data-wall data-tone={p.stage.tone}>
        <div class="cs-wall__view">
          <div class="cs-wall__plane" data-wall-plane>
            {wall.map((col, c) => (
              <div class={`cs-wall__col cs-wall__col--${col.kind}`} data-wall-col={c}>
                {col.items.map((s, k) => (
                  <button class={`cs-wall__item cs-wall__item--${s.kind}`} type="button" data-zoom={s.src} data-zoom-kind={s.kind} data-cursor="View" aria-label={`Look closer: ${s.alt}`} tabindex={c * 4 + k < p.shots.length ? 0 : -1}>
                    <img src={small(s.src)} alt="" loading="lazy" decoding="async" width={s.kind === 'phone' ? 603 : 1440} height={s.kind === 'phone' ? 1311 : 944} />
                  </button>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="container cs-wall__head">
          <h2 class="cs-h cs-h--on" id="cs-wall-h"><span class="cs-h__n meta">{num('screens')}</span><span class="cs-h__t">Every screen</span></h2>
          <p class="cs-wall__note meta">{p.shots.length} screens from {p.name} · select any to look closer</p>
        </div>
      </section>
    )}

    <!-- ======================================================== live -->
    {p.live?.embed && (
      <section class="cs-sec container cs-live" aria-labelledby="cs-live-h" data-cs-section="Live">
        <h2 class="cs-h" id="cs-live-h"><span class="cs-h__n meta">{num('live')}</span><span class="cs-h__t">Live, right here</span></h2>
        <p class="cs-sec__body cs-lede">This is the real {p.live.host}, running now. Read today’s edition without leaving the page.</p>
        <div class="cs-sec__wide cs-live__win" data-live-frame={p.live.href}>
          <div class="cs-live__bar"><i></i><i></i><i></i><span class="cs-live__url">{p.live.host}</span><a href={p.live.href} target="_blank" rel="noopener" class="cs-live__out" aria-label={`Open ${p.live.host} in a new tab`}><Icon name="arrow-up-right" class="cs-live__icon" /></a></div>
          <button class="cs-live__cover" type="button" data-live-load data-cursor="Play">
            <img src={tex('d_home')} alt="" loading="lazy" decoding="async" />
            <span class="cs-live__play"><Icon name="play" class="cs-live__play-i" /><span>Load the live site</span></span>
          </button>
        </div>
      </section>
    )}

    <!-- ======================================================== code -->
    {p.repo ? (
      <section id="code" class="cs-sec container cs-code" aria-labelledby="cs-code-h" data-cs-section="The code">
        <h2 class="cs-h" id="cs-code-h"><span class="cs-h__n meta">{num('code')}</span><span class="cs-h__t">The code</span></h2>
        <p class="cs-sec__body cs-lede">The whole repository, open inside this page. Read the README, walk the tree, open any file. Press <kbd>⌘K</kbd> to jump to one.</p>
        <div class="cs-sec__wide cs-code__frame" data-code-frame data-active="false">
          <div class="cs-code__host" data-repo-inline={p.repo.slug}>
            <div class="cs-code__wait"><span class="meta">Opening {p.repo.url.replace('https://', '')}</span></div>
          </div>
          <!-- the page keeps the scroll until you choose to read the code -->
          <button class="cs-code__shield" type="button" data-code-shield data-cursor="Explore">
            <span class="cs-code__ask"><Icon name="code" class="cs-code__ask-i" /><span>Click to explore the code</span></span>
          </button>
        </div>
      </section>
    ) : (
      <section id="code" class="cs-sec container cs-code" aria-labelledby="cs-code-h" data-cs-section="The code">
        <h2 class="cs-h" id="cs-code-h"><span class="cs-h__n meta">{num('code')}</span><span class="cs-h__t">The code</span></h2>
        <div class="cs-sec__body">
          <p class="cs-lede">This is client work, so the theme lives in the brand’s own private repository. The store itself is the best place to see it working.</p>
          {p.live && <a class="cs-bigLink" href={p.live.href} target="_blank" rel="noopener" data-cursor="Open" data-live-open={p.live.embed ? p.slug : undefined}><span data-wave>{p.live.host}</span><Icon name="arrow-up-right" class="cs-bigLink__i" /></a>}
        </div>
      </section>
    )}

    <!-- ======================================================== where it is now -->
    <section class="cs-sec container cs-now" aria-labelledby="cs-now-h" data-cs-section="Where it is now">
      <h2 class="cs-h" id="cs-now-h"><span class="cs-h__n meta">{num('now')}</span><span class="cs-h__t">Where it is now</span></h2>
      <div class="cs-sec__body">
        <p class="cs-now__status meta"><Moon lit={lit} size={16} />{p.statusNote}</p>
        <p class="cs-now__x" data-brighten>{p.outcome}</p>
        <div class="cs-now__ctas">
          {p.live && <a class="btn btn--solid" href={p.live.href} target="_blank" rel="noopener" data-magnetic data-cursor="Open" data-live-open={p.live.embed ? p.slug : undefined}><span data-wave>{p.live.label}</span><Icon name="arrow-up-right" class="btn__arrow" /></a>}
          <a class={`btn ${p.live ? 'btn--ghost' : 'btn--solid'}`} href="/#contact" data-magnetic><span data-wave>Work with me</span><Icon name="arrow-up-right" class="btn__arrow" /></a>
        </div>
      </div>
    </section>

    <footer class="cs-foot container">
      <button class="cs-foot__mail" type="button" data-copy="bharatkhanna117@gmail.com" data-cursor="Copy"><span>bharatkhanna117@gmail.com</span><span class="meta" data-copy-state aria-live="polite">Click to copy</span></button>
      <ul class="cs-foot__links">
        <li><a href="/"><span data-wave>Home</span></a></li>
        <li><a href="/#work"><span data-wave>All the work</span></a></li>
        <li><a href="https://github.com/waterduckpani" target="_blank" rel="noopener"><span data-wave>GitHub</span></a></li>
        <li class="meta">© 2026 Oblune Studio</li>
      </ul>
    </footer>

    <!-- ======================================================== next: the page becomes the next case study -->
    <section class="cs-next" data-next aria-label={`Next case study: ${next.name}`}
      data-next-href={`/work/${next.slug}`} data-next-title={next.name} data-next-kicker={nKicker} data-next-lit={nLit} data-next-bg={nBg} data-next-ink={nInk}
      style={`--n-bg: ${nBg}; --n-ink: ${nInk}; --n-mute: color-mix(in srgb, ${nInk} 55%, transparent)`}>
      <a class="cs-next__panel" href={`/work/${next.slug}`} data-next-link data-cursor="Next">
        {['base', 'lit'].map((layer) => (
          <span class={`cs-next__layer cs-next__layer--${layer}`} aria-hidden={layer === 'lit' ? 'true' : undefined} data-next-layer={layer}>
            <span class="cs-next__top">
              <span class="meta">Next case study</span>
              <span class="meta cs-next__hint">Keep scrolling</span>
            </span>
            <span class="cs-next__line">{next.line}</span>
            <span class="cs-next__inner">
              <svg class="cs-next__moon" viewBox="-50 -50 100 100" aria-hidden="true">
                <circle class="cs-next__ring" r="47" />
                <circle class="cs-next__arc" r="47" pathLength="1" data-next-arc />
                <path transform="scale(0.78) rotate(24)" fill="currentColor" fill-rule="evenodd" d={emblemPath(nLit)} />
              </svg>
              <span class="cs-next__kicker">{nKicker}</span>
              <span class="cs-next__title" translate="no">{next.name}</span>
            </span>
          </span>
        ))}
      </a>
    </section>
  </main>

  <dialog class="zoom" data-zoom-dialog aria-label="Screen, enlarged">
    <button class="zoom__close" type="button" data-zoom-close aria-label="Close"><Icon name="x" class="zoom__x" /></button>
    <img alt="" data-zoom-img />
  </dialog>
</Base>

<style>
  .cs { position: relative; overflow-x: clip; --gap: clamp(112px, 12vw, 200px); }

  /* ---------- the shared section grid: label left (sticky), content right ---------- */
  .cs-sec {
    position: relative; z-index: 3;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start;
    padding-top: var(--gap);
  }
  .cs-h { grid-column: 1 / span 3; grid-row: 1 / span 9; align-self: stretch; font-weight: 400; }
  .cs-h__inner, .cs-h > * { position: sticky; }
  .cs-h__n { display: block; top: 108px; color: var(--ink-3); }
  .cs-h__t { display: block; top: 130px; margin-top: 8px; font-size: clamp(18px, 1.35vw, 22px); line-height: 1.15; letter-spacing: -0.025em; font-weight: 580; color: var(--ink); max-width: 11em; }
  .cs-sec__body { grid-column: 4 / -1; min-width: 0; }
  .cs-sec__wide { grid-column: 4 / -1; min-width: 0; margin-top: clamp(28px, 3vw, 44px); }
  .cs-lede { font-size: clamp(22px, 2vw, 34px); line-height: 1.18; letter-spacing: -0.035em; font-weight: 520; max-width: 24em; text-wrap: pretty; }
  .cs-lede kbd { font-family: var(--mono); font-size: 0.55em; padding: 3px 7px; border-radius: 6px; box-shadow: inset 0 0 0 1px var(--line-strong); vertical-align: 0.25em; }

  /* ---------- hero ---------- */
  .cs-hero { position: relative; z-index: 3; padding-top: 104px; }
  .cs-hero__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .cs-back { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; font-weight: 560; font-size: 14px; }
  :global(.cs-back__icon) { width: 16px; height: 16px; transition: transform 0.5s var(--ease-out); }
  .cs-back:hover :global(.cs-back__icon) { transform: translateX(-4px); }
  .cs-crumb span { margin: 0 0.7em; color: var(--ink-3); }
  .cs-name {
    margin: 0.02em 0 0 -0.055em;
    font-size: min(clamp(84px, 19vw, 360px), calc(94vw / (var(--len, 6) * 0.54))); line-height: 0.96; font-weight: 640; letter-spacing: -0.068em;
    white-space: nowrap;
  }
  .cs-hero__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); margin-top: clamp(20px, 2.4vw, 40px); align-items: start; }
  .cs-line { grid-column: 1 / span 6; font-size: clamp(28px, 3vw, 54px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 540; text-wrap: balance; max-width: 13em; }
  .cs-facts { grid-column: 8 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 18px var(--gutter); }
  .cs-facts dd { margin-top: 5px; font-size: 15px; font-weight: 540; line-height: 1.35; }
  .cs-facts__wide { grid-column: 1 / -1; }
  .cs-status { display: inline-flex; align-items: center; gap: 8px; }
  .cs-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; margin-top: clamp(28px, 3vw, 48px); }
  .cs-gh { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 8px; font-weight: 560; font-size: 15px; }
  :global(.cs-gh__icon) { width: 19px; height: 19px; }
  .cs-cmd {
    display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 18px; border-radius: 999px; border: 0; cursor: pointer;
    background: var(--ink); color: var(--bg); font-family: var(--mono); font-size: 14px;
  }
  .cs-cmd > span:first-child { opacity: 0.5; }
  .cs-cmd .meta { color: inherit; opacity: 0.6; }
  .cs-cmd:active { transform: scale(0.97); }

  /* ---------- stage ---------- */
  .cs-stage {
    position: relative; margin-top: clamp(56px, 7vw, 120px);
    height: clamp(560px, 96vh, 1100px);
    background: radial-gradient(120% 90% at 70% 30%, var(--c-glow), var(--c-bg) 62%);
    overflow: hidden; isolation: isolate;
    color: var(--c-ink);
  }
  .cs-stage__moon { position: absolute; z-index: -1; left: 50%; top: 50%; width: min(78vh, 72vw); aspect-ratio: 1; translate: -50% -50%; }
  .cs-stage__moon svg { width: 100%; height: 100%; overflow: visible; will-change: transform; }
  .cs-stage__float { will-change: transform; }
  .cs-stage__orbit { fill: none; stroke: currentColor; stroke-opacity: 0.18; stroke-width: 0.15; }
  .cs-stage__set { position: absolute; inset: 0; }
  .cs-stage__dv { position: absolute; }
  .cs-stage--trio .cs-stage__dv { width: clamp(150px, 19vw, 330px); top: 50%; }
  .cs-stage__dv--c { left: 50%; translate: -50% -50%; z-index: 2; }
  .cs-stage__dv--l { left: 50%; translate: calc(-50% - 88%) -46%; rotate: -4deg; z-index: 1; }
  .cs-stage__dv--r { left: 50%; translate: calc(-50% + 88%) -44%; rotate: 4deg; z-index: 1; }
  .cs-stage__dv--desk { width: min(62vw, 128vh); left: 46%; top: 50%; translate: -50% -52%; }
  .cs-stage__dv--phone { width: min(15vw, 30vh); left: calc(46% + min(31vw, 64vh) - min(9vw, 18vh)); top: 50%; translate: 0 -34%; z-index: 2; }
  .cs-stage__dv--term { width: min(64vw, 120vh); left: 50%; top: 50%; translate: -50% -50%; }
  .cs-stage__cap { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 18px; display: flex; justify-content: space-between; color: inherit; opacity: 0.7; }

  /* ---------- numbers ---------- */
  .cs-numbers { padding-top: clamp(80px, 8vw, 140px); }
  .cs-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(36px, 4vw, 64px) var(--gutter); }
  .cs-metric { padding-top: 20px; border-top: 1px solid var(--ink); }
  .cs-metric__v { display: flex; align-items: baseline; gap: 0.18em; font-size: clamp(64px, 7.4vw, 140px); line-height: 0.9; letter-spacing: -0.06em; font-weight: 560; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cs-metric__u { font-size: 0.24em; letter-spacing: -0.02em; font-weight: 540; color: var(--ink-2); }
  .cs-metric__l { margin-top: 16px; color: var(--ink); font-size: clamp(16px, 1.2vw, 19px); line-height: 1.4; max-width: 30ch; }
  .cs-metric__s { margin-top: 10px; color: var(--ink-3); }

  /* ---------- brief ---------- */
  .cs-brief__lead { font-size: clamp(26px, 2.9vw, 52px); line-height: 1.12; letter-spacing: -0.04em; font-weight: 500; text-wrap: pretty; }
  .cs-brief__p { margin-top: clamp(24px, 2.6vw, 40px); font-size: clamp(18px, 1.45vw, 24px); line-height: 1.45; color: var(--ink-2); max-width: 40em; margin-left: auto; text-wrap: pretty; }

  /* ---------- walkthrough ---------- */
  .cs-walk__steps { grid-column: 4 / span 4; grid-row: 1; }
  .cs-walk__stage { grid-column: 8 / -1; grid-row: 1; align-self: stretch; position: relative; }
  .cs-walk--pair .cs-walk__steps, .cs-walk--terminal .cs-walk__steps { grid-column: 4 / span 3; }
  .cs-walk--pair .cs-walk__stage, .cs-walk--terminal .cs-walk__stage { grid-column: 7 / -1; }
  .cs-walk__step { min-height: 72vh; padding-top: 10vh; color: var(--ink-3); transition: color 0.6s var(--ease-out); }
  .cs-walk__step:first-child { padding-top: 0; min-height: 62vh; }
  .cs-walk__step:last-child { min-height: 52vh; }
  .cs-walk__step[data-on='true'] { color: var(--ink); }
  .cs-walk__n { color: inherit; }
  .cs-walk__t { margin-top: 14px; font-size: clamp(28px, 2.6vw, 46px); line-height: 1.02; letter-spacing: -0.045em; font-weight: 560; text-wrap: balance; max-width: 12em; }
  .cs-walk__x { margin-top: 16px; font-size: clamp(16px, 1.2vw, 19px); max-width: 34ch; color: inherit; opacity: 0.85; }
  .cs-walk__step[data-on='true'] .cs-walk__x { color: var(--ink-2); opacity: 1; }
  .cs-walk__inline { display: none; }
  .cs-walk__sticky { position: sticky; top: 0; height: 100vh; display: grid; place-items: center; margin-top: -16vh; }
  .cs-walk__frames { position: relative; width: 100%; height: 76vh; }
  /* the product's own colour, a soft moon behind its screens */
  .cs-walk__glow { position: absolute; left: 50%; top: 50%; width: min(100%, 64vh); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; background: radial-gradient(circle at 62% 36%, var(--c-glow), var(--c-bg) 70%); }
  .cs-walk--pair .cs-walk__glow { left: 44%; }
  .cs-walk__desk, .cs-walk__phone { position: absolute; }
  .cs-walk--pair .cs-walk__desk { left: 0; top: 50%; translate: 0 -56%; width: 88%; aspect-ratio: 2880 / 1888; }
  .cs-walk--pair .cs-walk__phone { right: 0; top: 50%; translate: 0 -30%; width: min(24%, 17vh); aspect-ratio: 1206 / 2622; z-index: 2; }
  .cs-walk--phone .cs-walk__phone { left: 50%; top: 50%; translate: -50% -50%; height: 72vh; aspect-ratio: 1266 / 2690; }
  .cs-walk__frames :global(.cs-walk__frame) { position: absolute; inset: 0; opacity: 0; transform: translateY(24px) scale(0.985); transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-out); }
  .cs-walk__frames :global(.cs-walk__frame[data-on='true']) { opacity: 1; transform: none; }
  .cs-walk--terminal .cs-walk__sticky :global(.gate) { width: 100%; }

  /* ---------- decisions ---------- */
  .cs-decide__list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--gutter); }
  .cs-decide__item { display: grid; grid-template-columns: 48px 1fr; column-gap: 12px; padding: 26px 0 44px; border-top: 1px solid var(--line); }
  .cs-decide__n { grid-row: span 2; color: var(--ink-3); padding-top: 0.7em; }
  .cs-decide__t { font-size: clamp(24px, 2.1vw, 36px); line-height: 1.05; letter-spacing: -0.04em; font-weight: 560; }
  .cs-decide__x { margin-top: 14px; color: var(--ink-2); max-width: 44ch; font-size: clamp(16px, 1.15vw, 18px); }

  /* ---------- system: a line runs down the pipeline, and each part lights as it arrives ---------- */
  .cs-sys { position: relative; --dot: 13px; }
  .cs-sys__rail { position: absolute; left: calc(var(--dot) / 2 - 0.5px); top: 10px; bottom: 60px; width: 1px; background-image: linear-gradient(var(--line-strong) 40%, transparent 0); background-size: 1px 8px; }
  .cs-sys__drawn { position: absolute; inset: 0; background: var(--ink); transform-origin: 50% 0; transform: scaleY(0); }
  .cs-sys__bead { position: absolute; left: 50%; top: 0; translate: -50% -50%; width: 18px; height: 18px; color: var(--ink); background: var(--bg); border-radius: 50%; display: grid; place-items: center; }
  .cs-sys__node {
    position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--gutter);
    padding: 0 0 clamp(36px, 4vw, 60px) calc(var(--dot) + 28px);
    opacity: 0.32; transition: opacity 0.6s var(--ease-out);
  }
  .cs-sys__node[data-on='true'] { opacity: 1; }
  .cs-sys__dot { position: absolute; left: 0; top: 4px; width: var(--dot); height: var(--dot); border-radius: 50%; background: var(--bg); box-shadow: inset 0 0 0 1.25px var(--line-strong); transition: background-color 0.4s, box-shadow 0.4s; }
  .cs-sys__node[data-on='true'] .cs-sys__dot { background: var(--ink); box-shadow: inset 0 0 0 1.25px var(--ink); }
  .cs-sys__i { grid-column: 1; color: var(--ink-3); }
  .cs-sys__t { grid-column: 1; margin-top: 6px; font-size: clamp(22px, 2vw, 34px); line-height: 1.05; letter-spacing: -0.04em; font-weight: 560; }
  .cs-sys__x { grid-column: 2; grid-row: 1 / span 2; align-self: end; color: var(--ink-2); font-size: clamp(16px, 1.15vw, 18px); line-height: 1.45; max-width: 40ch; }

  /* ---------- screens: a tilted wall in the product's colour ---------- */
  .cs-wall {
    position: relative; z-index: 3; margin-top: var(--gap);
    height: clamp(640px, 118vh, 1300px); overflow: hidden; isolation: isolate;
    background: radial-gradient(110% 80% at 70% 20%, var(--c-glow), var(--c-bg) 66%);
    color: var(--c-ink);
  }
  .cs-wall__view { position: absolute; inset: 0; perspective: 2200px; perspective-origin: 50% 30%; }
  .cs-wall__plane {
    position: absolute; left: 50%; top: 50%; width: 170vw;
    display: flex; align-items: flex-start; justify-content: center; gap: clamp(16px, 1.8vw, 32px);
    transform: translate(-50%, -50%) rotateX(26deg) rotateZ(-13deg);
  }
  .cs-wall__col { display: grid; gap: clamp(16px, 1.8vw, 32px); flex: none; will-change: transform; }
  .cs-wall__col--phone { width: clamp(150px, 13vw, 250px); }
  .cs-wall__col--desktop { width: clamp(320px, 30vw, 560px); }
  .cs-wall__item {
    display: block; padding: 0; border: 0; background: #0b0b0d; cursor: zoom-in; overflow: hidden;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(255 255 255 / 0.08);
    transition: transform 0.8s var(--ease-out), box-shadow 0.8s var(--ease-out);
  }
  .cs-wall__item--phone { border-radius: 9% / 4.2%; aspect-ratio: 1206 / 2622; }
  .cs-wall__item--desktop { border-radius: 10px; aspect-ratio: 2880 / 1888; }
  .cs-wall__item img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .cs-wall__item:hover, .cs-wall__item:focus-visible { transform: translateY(-8px) scale(1.04); box-shadow: 0 60px 100px -30px rgb(0 0 0 / 0.65), 0 0 0 1px rgb(255 255 255 / 0.2); }
  /* the head reads over the wall: the colour gathers behind it */
  .cs-wall__head {
    position: absolute; left: 0; right: 0; top: 0; z-index: 2; pointer-events: none;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    padding-top: clamp(40px, 5vw, 72px); padding-bottom: 120px;
    background: linear-gradient(to bottom, var(--c-bg) 10%, color-mix(in srgb, var(--c-bg) 70%, transparent) 55%, transparent);
  }
  .cs-wall__head .cs-h { grid-row: 1; }
  .cs-wall__head .cs-h > * { position: static; }
  .cs-h--on .cs-h__n, .cs-h--on .cs-h__t { color: var(--c-ink); }
  .cs-h--on .cs-h__n { opacity: 0.6; }
  .cs-wall__note { grid-column: 4 / -1; grid-row: 1; align-self: end; color: var(--c-ink); opacity: 0.7; }
  .cs-wall::after { content: ''; position: absolute; inset: auto 0 0 0; height: 22%; z-index: 1; pointer-events: none; background: linear-gradient(to top, var(--c-bg), transparent); }

  /* ---------- live ---------- */
  .cs-live__win { border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px var(--line), 0 60px 120px -60px rgba(14, 14, 18, 0.5); height: min(80vh, 880px); display: grid; grid-template-rows: 44px 1fr; }
  .cs-live__bar { display: flex; align-items: center; gap: 8px; padding: 0 14px; background: #f3f2ee; border-bottom: 1px solid rgba(0, 0, 0, 0.07); }
  .cs-live__bar i { width: 12px; height: 12px; border-radius: 50%; background: #d9d8d3; }
  .cs-live__url { flex: 1; text-align: center; font-size: 13px; color: #55565b; }
  .cs-live__out { display: grid; place-items: center; width: 30px; height: 30px; color: #55565b; }
  :global(.cs-live__icon) { width: 16px; height: 16px; }
  .cs-live__cover { position: relative; border: 0; padding: 0; cursor: pointer; background: #111; overflow: hidden; }
  .cs-live__cover img { width: 100%; height: 100%; object-fit: cover; object-position: top; filter: saturate(0.9); transition: transform 1.2s var(--ease-out), filter 0.6s; }
  .cs-live__cover:hover img { transform: scale(1.02); filter: saturate(1) brightness(0.92); }
  .cs-live__play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 24px 0 18px; border-radius: 999px; background: var(--ink); color: var(--bg); font-weight: 560; font-size: 16px; box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.4); }
  :global(.cs-live__play-i) { width: 20px; height: 20px; }
  .cs-live__win iframe { width: 100%; height: 100%; border: 0; background: #fff; }

  /* ---------- code ---------- */
  .cs-code__frame { position: relative; }
  .cs-code__host { height: min(80vh, 860px); min-height: 520px; border-radius: 18px; background: #0e0e10; overflow: hidden; }
  .cs-code__wait { height: 100%; display: grid; place-items: center; }
  .cs-code__wait .meta { color: #6d6e75; }
  .cs-code__shield {
    position: absolute; inset: 0; z-index: 2; border: 0; padding: 0 0 32px; border-radius: 18px; cursor: pointer;
    background: linear-gradient(to top, rgb(14 14 16 / 0.6), rgb(14 14 16 / 0) 45%);
    display: grid; place-items: end center;
    transition: opacity 0.4s var(--ease-out);
  }
  .cs-code__ask {
    display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0 20px 0 16px; border-radius: 999px;
    background: #ececee; color: #141416; font-size: 15px; font-weight: 600;
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.5);
    transition: transform 0.5s cubic-bezier(0.2, 1.4, 0.3, 1);
  }
  .cs-code__shield:hover .cs-code__ask, .cs-code__shield:focus-visible .cs-code__ask { transform: scale(1.05); }
  :global(.cs-code__ask-i) { width: 18px; height: 18px; }
  .cs-code__frame[data-active='true'] .cs-code__shield { opacity: 0; pointer-events: none; }
  .cs-bigLink { display: inline-flex; align-items: flex-start; gap: 10px; margin-top: 28px; font-size: clamp(40px, 5vw, 90px); font-weight: 560; letter-spacing: -0.05em; line-height: 1; padding-bottom: 8px; background: linear-gradient(currentColor, currentColor) 0 100% / 0% 2px no-repeat; transition: background-size 0.7s var(--ease-out); }
  .cs-bigLink:hover { background-size: 100% 2px; }
  :global(.cs-bigLink__i) { width: 0.5em; height: 0.5em; margin-top: 0.12em; }

  /* ---------- where it is now ---------- */
  .cs-now__status { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .cs-now__x { margin-top: 20px; font-size: clamp(30px, 3.4vw, 62px); line-height: 1.05; letter-spacing: -0.045em; font-weight: 540; max-width: 18em; text-wrap: pretty; }
  .cs-now__ctas { display: flex; flex-wrap: wrap; gap: 12px 14px; margin-top: clamp(32px, 3vw, 48px); }

  /* ---------- foot ---------- */
  .cs-foot { position: relative; z-index: 3; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px 32px; margin-top: var(--gap); padding-block: 22px 26px; border-top: 1px solid var(--line); }
  .cs-foot__mail { border: 0; background: none; padding: 0; cursor: pointer; display: grid; gap: 4px; text-align: left; color: var(--ink); font-size: clamp(17px, 1.4vw, 22px); font-weight: 540; }
  .cs-foot__mail .meta { color: var(--ink-2); }
  .cs-foot__links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; font-size: 14px; font-weight: 560; }
  .cs-foot__links a { display: inline-block; min-height: 44px; line-height: 44px; }
  .cs-foot__links .meta { color: var(--ink-2); }

  /* ---------- next: scroll on and the page becomes the next case study ---------- */
  .cs-next { position: relative; z-index: 3; height: 210svh; }
  .cs-next__panel { position: sticky; top: 0; display: block; height: 100svh; overflow: hidden; color: var(--ink); }
  .cs-next__layer { position: absolute; inset: 0; display: block; }
  .cs-next__layer--lit { background: var(--n-bg); color: var(--n-ink); clip-path: ellipse(0% 105% at 100% 50%); }
  .cs-next__top { position: absolute; left: var(--gutter); right: var(--gutter); top: 112px; display: flex; justify-content: space-between; gap: 16px; }
  .cs-next__top .meta { color: inherit; opacity: 0.6; }
  .cs-next__line { position: absolute; left: var(--gutter); top: 150px; max-width: 18em; font-size: clamp(22px, 2.2vw, 38px); line-height: 1.1; letter-spacing: -0.035em; font-weight: 520; }
  /* these match the curtain exactly (Curtain.astro), so the hand-over cannot be seen */
  .cs-next__inner {
    position: absolute; left: var(--gutter); right: var(--gutter); bottom: clamp(28px, 7vh, 72px);
    display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: clamp(16px, 2vw, 28px); align-items: end;
  }
  .cs-next__moon { grid-row: 1 / span 2; width: clamp(44px, 5.4vw, 84px); height: auto; overflow: visible; margin-bottom: 0.4vw; }
  .cs-next__ring { fill: none; stroke: currentColor; stroke-opacity: 0.18; stroke-width: 2; }
  .cs-next__arc { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transform: rotate(-90deg); }
  .cs-next__kicker { font-family: var(--mono); font-size: 12px; letter-spacing: 0.02em; color: var(--ink-3); white-space: nowrap; overflow: hidden; }
  .cs-next__layer--lit .cs-next__kicker { color: var(--n-mute); }
  .cs-next__title {
    font-size: clamp(56px, 11vw, 210px); line-height: 0.92; letter-spacing: -0.065em; font-weight: 620;
    white-space: nowrap; overflow: hidden; padding: 0.02em 0.06em 0.1em 0; margin-left: -0.04em;
  }

  /* ---------- zoom ---------- */
  .zoom { width: 100vw; height: 100svh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(12, 12, 14, 0.9); }
  .zoom[open] { display: grid; place-items: center; }
  .zoom img { max-width: calc(100vw - 48px); max-height: calc(100svh - 48px); width: auto; height: auto; border-radius: 12px; box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6); cursor: zoom-out; }
  .zoom[data-kind='phone'] img { border-radius: 36px; }
  .zoom::backdrop { background: transparent; }
  .zoom__close { position: fixed; top: 16px; right: 16px; width: 48px; height: 48px; border-radius: 50%; border: 0; background: #ecece9; color: #141416; cursor: pointer; display: grid; place-items: center; z-index: 2; }
  :global(.zoom__x) { width: 20px; height: 20px; }

  @media (max-width: 1100px) and (min-width: 861px) {
    .cs-h { grid-column: 1 / span 2; }
    .cs-sec__body, .cs-sec__wide { grid-column: 3 / -1; }
    .cs-walk__steps, .cs-walk--pair .cs-walk__steps, .cs-walk--terminal .cs-walk__steps { grid-column: 3 / span 4; }
    .cs-walk__stage, .cs-walk--pair .cs-walk__stage, .cs-walk--terminal .cs-walk__stage { grid-column: 7 / -1; }
    .cs-wall__note { grid-column: 3 / -1; }
  }

  /* ---------- phones ---------- */
