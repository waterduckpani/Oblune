---
// Lab page: renders each project's cover still (menu cards, index previews, share image) for export.
// The devices are the home stage's own (same body, metal, studio light and screen shader), loaded
// with the full-size screens, over the project's colour. Not part of the build (see astro.config).
import { projects } from '../../data/projects';
const colours = Object.fromEntries(projects.map((p) => [p.slug, p.stage]));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Stage lab</title>
    <style>
      html, body { margin: 0; height: 100%; overflow: hidden; }
      body { background: var(--bg); background-image: radial-gradient(120% 95% at 64% 22%, var(--glow) 0%, var(--bg) 68%); }
      canvas { display: block; width: 100vw; height: 100vh; }
    </style>
  </head>
  <body>
    <canvas id="c"></canvas>
    <script is:inline define:vars={{ colours }}>window.__colours = colours;</script>
    <script>
      import '@fontsource-variable/jetbrains-mono';
      import * as THREE from 'three';
      import { Device } from '../../lib/world/devices';
      import { Terminal } from '../../lib/world/terminal';
      import { ENV_GLSL } from '../../lib/world/glsl';

      const project = new URLSearchParams(location.search).get('p') || 'mull';
      const stage = (window as any).__colours[project] as { bg: string; glow: string; tone: string };
      document.body.style.setProperty('--bg', stage.bg);
      document.body.style.setProperty('--glow', stage.glow);
      const dark = stage.tone === 'dark';

      const canvas = document.getElementById('c') as HTMLCanvasElement;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, preserveDrawingBuffer: true });
      renderer.setPixelRatio(devicePixelRatio);
      renderer.setSize(innerWidth, innerHeight, false);
      renderer.setClearColor(0x000000, 0);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      // the home stage's camera: one world unit is one CSS pixel at z = 0
      const W = innerWidth, H = innerHeight;
      const camera = new THREE.PerspectiveCamera(30, W / H, 1, 10000);
      const dist = H / 2 / Math.tan((15 * Math.PI) / 180);
      // ?pull=1.4 backs the camera off, for the menu's small cards where a crop past the edge reads as a mistake
      const pull = Number(new URLSearchParams(location.search).get('pull')) || 1;
      camera.position.set(0, 0, dist * pull);
      camera.near = dist * 0.1; camera.far = dist * 3 * pull;
      camera.updateProjectionMatrix();

      const scene = new THREE.Scene();
      {
        const env = new THREE.Scene();
        env.add(new THREE.Mesh(new THREE.SphereGeometry(10, 64, 32), new THREE.ShaderMaterial({
          side: THREE.BackSide,
          vertexShader: 'varying vec3 vDir; void main(){ vDir = normalize(position); gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }',
          fragmentShader: `varying vec3 vDir;\n${ENV_GLSL}\nvoid main(){ gl_FragColor = vec4(studioEnv(normalize(vDir), vec2(0.0)), 1.0); }`,
        })));
        const pmrem = new THREE.PMREMGenerator(renderer);
        scene.environment = pmrem.fromScene(env, 0.012).texture;
      }

      // a soft shadow under each device, as on the home stage
      const shadowMap = (() => {
        const c = document.createElement('canvas');
        c.width = c.height = 256;
        const g = c.getContext('2d')!;
        g.filter = 'blur(24px)';
        g.fillStyle = '#000';
        g.beginPath(); g.roundRect(60, 60, 136, 136, 26); g.fill();
        return new THREE.CanvasTexture(c);
      })();

      const loader = new THREE.ImageBitmapLoader();
      loader.setOptions({ imageOrientation: 'flipY', premultiplyAlpha: 'none' });
      const load = (name: string) => new Promise<THREE.Texture>((res, rej) => loader.load(`/work/tex/${project}/${name}.webp`, (bmp) => {
        const t = new THREE.Texture(bmp as unknown as HTMLImageElement);
        t.colorSpace = THREE.SRGBColorSpace;
        t.flipY = false;
        t.anisotropy = renderer.capabilities.getMaxAnisotropy();
        t.minFilter = THREE.LinearMipmapLinearFilter;
        t.needsUpdate = true;
        res(t);
      }, undefined, rej));

      type Place = { x: number; y: number; z?: number; rx?: number; ry?: number; rz?: number; size: number; bright?: number };
      /** size: a phone's height, or a display's width, in px */
      function put(kind: 'phone' | 'plate', tex: THREE.Texture, p: Place) {
        const d = new Device(kind);
        const s = d.spec;
        d.group.scale.setScalar(kind === 'phone' ? p.size / d.height : p.size / (1 + (s.bezel + s.rim) * 2));
        d.group.position.set(p.x, p.y, p.z ?? 0);
        d.group.rotation.set(p.rx ?? -0.03, p.ry ?? 0, p.rz ?? 0);
        d.set(tex, null, 0);
        d.screen.uniforms.uBright.value = p.bright ?? 1;
        d.screen.uniforms.uSheen.value = 0.45 + (p.ry ?? 0) * 0.9;
        scene.add(d.group);
        const sc = d.group.scale.x;
        const sh = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), new THREE.MeshBasicMaterial({ map: shadowMap, color: 0x0c0d10, transparent: true, opacity: dark ? 0.5 : 0.26, depthWrite: false }));
        sh.renderOrder = -1;
        sh.scale.set(sc * (kind === 'phone' ? 1.18 : 1.08) * (0.3 + 0.7 * Math.abs(Math.cos(p.ry ?? 0))) * 1.3, sc * d.height * 1.04 * 1.22, 1);
        sh.position.set(p.x + W * 0.018 + (p.z ?? 0) * 0.06, p.y - H * 0.03 - (p.z ?? 0) * 0.05, (p.z ?? 0) - 160);
        sh.rotation.z = p.rz ?? 0;
        scene.add(sh);
      }

      // Each cover is composed for its product, so the eight never read as one template.
      const covers: Record<string, () => Promise<void>> = {
        // one honest number: a single phone, close, the ledger of who owes who behind it
        mull: async () => {
          const [home, owes] = await Promise.all([load('home'), load('owes')]);
          put('phone', owes, { x: W * 0.25, y: H * 0.1, z: -280, ry: -0.36, rz: 0.06, size: H * 0.8, bright: 0.72 });
          put('phone', home, { x: -W * 0.08, y: -H * 0.17, z: 120, rx: -0.1, ry: 0.26, rz: -0.13, size: H * 1.12 });
        },
        // the news as a deck: cards stacked and fanned, the top one mid-swipe
        bite: async () => {
          const [a, b, c, top] = await Promise.all([load('saved'), load('discover'), load('feed'), load('swipe')]);
          const h = H * 0.78;
          put('phone', a, { x: -W * 0.16, y: -H * 0.01, z: -240, rz: 0.14, size: h, bright: 0.78 });
          put('phone', b, { x: -W * 0.095, y: -H * 0.005, z: -160, rz: 0.08, size: h, bright: 0.86 });
          put('phone', c, { x: -W * 0.03, y: 0, z: -80, rz: 0.025, size: h, bright: 0.94 });
          put('phone', top, { x: W * 0.17, y: H * 0.035, z: 40, ry: -0.12, rz: -0.2, size: h });
        },
        // a voice note becomes a claim: three steps down a staircase, left to right
        haqdar: async () => {
          const [a, b, c] = await Promise.all([load('record'), load('matches'), load('why')]);
          const h = H * 0.68;
          put('phone', a, { x: -W * 0.27, y: H * 0.15, z: -220, ry: 0.16, size: h, bright: 0.82 });
          put('phone', b, { x: 0, y: H * 0.02, z: -70, ry: 0.08, size: h, bright: 0.92 });
          put('phone', c, { x: W * 0.27, y: -H * 0.095, z: 80, size: h });
        },
        // a paper on the desk: the front page lying back, the phone set down on it
        article: async () => {
          const [d, m] = await Promise.all([load('d_home'), load('m_story')]);
          put('plate', d, { x: -W * 0.06, y: H * 0.06, z: -80, rx: -0.78, rz: 0.22, size: W * 0.98 });
          put('phone', m, { x: W * 0.26, y: -H * 0.2, z: 160, rx: -0.5, rz: -0.18, size: H * 0.7 });
        },
        // the world in a browser: the globe too big for the frame, the morning briefing in hand
        'power-policy': async () => {
          const [d, m] = await Promise.all([load('d_globe'), load('m_briefing')]);
          put('plate', d, { x: W * 0.15, y: -H * 0.05, z: -60, ry: -0.1, size: W * 1.0 });
          put('phone', m, { x: -W * 0.31, y: -H * 0.01, z: 170, ry: 0.24, rz: -0.035, size: H * 0.64 });
        },
        // the lesson first: the phone forward, the chart it is about turned away behind it
        stocky: async () => {
          const [d, m] = await Promise.all([load('d_chart'), load('m_concept')]);
          put('plate', d, { x: W * 0.16, y: H * 0.07, z: -240, ry: -0.32, size: W * 0.66, bright: 0.86 });
          put('phone', m, { x: -W * 0.19, y: -H * 0.005, z: 130, ry: 0.3, rz: -0.04, size: H * 0.72 });
        },
        // a lookbook: two pages of the store side by side, like a spread
        'viraj-mahajan': async () => {
          const [a, b] = await Promise.all([load('m_home'), load('m_product')]);
          put('phone', a, { x: -W * 0.14, y: H * 0.03, z: -40, ry: 0.2, rz: 0.035, size: H * 0.76 });
          put('phone', b, { x: W * 0.14, y: -H * 0.03, z: 40, ry: -0.2, rz: -0.035, size: H * 0.76 });
        },
      };

      async function build() {
        if (covers[project]) await covers[project]();
        else if (project === 'alfard') {
          // the session typed through to the approval and the reply
          await document.fonts.load('400 32px "JetBrains Mono Variable"');
          await document.fonts.load('700 32px "JetBrains Mono Variable"');
          const term = new Terminal();
          await new Promise((r) => setTimeout(r, 300));
          term.update(1, 0);
          put('plate', term.texture, { x: 0, y: H * 0.01, rx: -0.04, ry: 0.16, size: W * 0.7 });
        }
        // compile and upload everything, then draw once
        await renderer.compileAsync(scene, camera);
        renderer.render(scene, camera);
        await new Promise((r) => requestAnimationFrame(r));
        renderer.render(scene, camera);
        (window as any).__done = true;
      }
      build();
    </script>
  </body>
</html>
