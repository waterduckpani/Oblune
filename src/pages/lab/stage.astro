---
// Lab page: renders the Oblune stage stills (one per project) for export.
// Every project shares one studio, one camera language and one device family.
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Stage lab</title>
    <style>
      html, body { margin: 0; background: #ecece9; }
      canvas { display: block; width: 100vw; height: 100vh; }
    </style>
  </head>
  <body>
    <canvas id="c"></canvas>
    <script>
      import '@fontsource-variable/jetbrains-mono';
      import * as THREE from 'three';
      import { RoundedBoxGeometry } from 'three/examples/jsm/geometries/RoundedBoxGeometry.js';

      const q = new URLSearchParams(location.search);
      const project = q.get('p') || 'mull';
      const transparent = q.get('bg') !== '1';

      const canvas = document.getElementById('c') as HTMLCanvasElement;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, preserveDrawingBuffer: true });
      renderer.setPixelRatio(window.devicePixelRatio);
      renderer.setSize(innerWidth, innerHeight, false);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.0;
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.VSMShadowMap;

      const scene = new THREE.Scene();
      if (!transparent) scene.background = new THREE.Color('#ecece9');

      // ---- Studio environment: the same light as the hero emblem's shader ----
      const envScene = new THREE.Scene();
      const envMat = new THREE.ShaderMaterial({
        side: THREE.BackSide,
        vertexShader: `varying vec3 vDir; void main(){ vDir = normalize(position); gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0); }`,
        fragmentShader: `
          varying vec3 vDir;
          float softbox(vec3 d, float az, float el, float w, float h, float soft) {
            float a = atan(d.x, d.z); float e = asin(clamp(d.y,-1.0,1.0));
            float da = abs(a - az); da = min(da, 6.2831853 - da);
            return smoothstep(w + soft, w, da) * smoothstep(h + soft, h, abs(e - el));
          }
          void main(){
            vec3 d = normalize(vDir); float y = d.y;
            vec3 col = mix(vec3(0.075,0.078,0.086), vec3(0.30,0.31,0.33), smoothstep(-0.55,0.02,y));
            col = mix(col, vec3(0.86,0.87,0.89), smoothstep(0.05,0.85,y));
            col += vec3(1.25) * exp(-pow((y-0.035)/0.03,2.0));
            col += vec3(0.35) * exp(-pow((y-0.035)/0.12,2.0));
            col += vec3(2.6) * softbox(d, -0.55, 0.18, 0.07, 0.62, 0.05);
            col += vec3(1.1) * softbox(d, 0.72, 0.1, 0.05, 0.5, 0.06);
            col += vec3(0.9) * softbox(d, 2.3, 0.25, 0.25, 0.4, 0.2);
            col += vec3(0.9) * softbox(d, -2.4, 0.2, 0.2, 0.45, 0.2);
            col *= 1.0 - 0.55 * softbox(d, 0.25, 0.0, 0.12, 0.9, 0.08);
            gl_FragColor = vec4(col, 1.0);
          }`,
      });
      envScene.add(new THREE.Mesh(new THREE.SphereGeometry(10, 64, 32), envMat));
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(envScene, 0.015).texture;
      scene.environmentIntensity = 1.0;

      // ---- Shadow: a key light casting onto a backdrop that stands in for the page ----
      const key = new THREE.DirectionalLight(0xffffff, 0.001);
      key.position.set(-2.4, 3.2, 5);
      key.castShadow = true;
      key.shadow.mapSize.set(2048, 2048);
      key.shadow.radius = 14;
      key.shadow.blurSamples = 24;
      Object.assign(key.shadow.camera, { left: -4, right: 4, top: 3, bottom: -3, near: 0.5, far: 14 });
      scene.add(key);
      const backdrop = new THREE.Mesh(new THREE.PlaneGeometry(30, 20), new THREE.ShadowMaterial({ opacity: 0.16, color: 0x1a1b20 }));
      backdrop.position.z = -0.42;
      backdrop.receiveShadow = true;
      scene.add(backdrop);

      // ---- Materials ----
      const metal = new THREE.MeshPhysicalMaterial({ color: '#e8eaed', metalness: 1, roughness: 0.16 });
      const glassBlack = new THREE.MeshPhysicalMaterial({ color: '#0b0b0d', metalness: 0, roughness: 0.06, clearcoat: 1, clearcoatRoughness: 0.04 });
      const sheen = new THREE.MeshPhysicalMaterial({ color: '#000000', metalness: 0, roughness: 0.05, transparent: true, opacity: 0.16, depthWrite: false });

      const loader = new THREE.TextureLoader();
      const loadTex = (url: string) => new Promise<THREE.Texture>((res, rej) => loader.load(url, (t) => { t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = renderer.capabilities.getMaxAnisotropy(); res(t); }, undefined, rej));

      function roundedRect(w: number, h: number, r: number) {
        const s = new THREE.Shape();
        const x = -w / 2, y = -h / 2;
        s.moveTo(x + r, y); s.lineTo(x + w - r, y); s.quadraticCurveTo(x + w, y, x + w, y + r);
        s.lineTo(x + w, y + h - r); s.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
        s.lineTo(x + r, y + h); s.quadraticCurveTo(x, y + h, x, y + h - r);
        s.lineTo(x, y + r); s.quadraticCurveTo(x, y, x + r, y);
        const g = new THREE.ShapeGeometry(s, 24);
        // remap UVs to 0..1 over the rectangle
        const uv = g.attributes.uv as THREE.BufferAttribute; const pos = g.attributes.position as THREE.BufferAttribute;
        for (let i = 0; i < uv.count; i++) uv.setXY(i, (pos.getX(i) + w / 2) / w, (pos.getY(i) + h / 2) / h);
        return g;
      }

      // cover-fit a texture into an aspect ratio, anchored to the top (screens read from the top)
      function cover(tex: THREE.Texture, aspect: number, anchorTop = true) {
        const img = tex.image as { width: number; height: number };
        const ia = img.width / img.height;
        tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
        if (ia > aspect) { tex.repeat.set(aspect / ia, 1); tex.offset.set((1 - aspect / ia) / 2, 0); }
        else { tex.repeat.set(1, ia / aspect); tex.offset.set(0, anchorTop ? 1 - ia / aspect : (1 - ia / aspect) / 2); }
        return tex;
      }

      function device(kind: 'phone' | 'plate', tex: THREE.Texture) {
        const g = new THREE.Group();
        const dims = kind === 'phone'
          ? { sw: 0.7, sh: 1.52, bezel: 0.03, frame: 0.018, depth: 0.085, r: 0.115, sr: 0.085 }
          : { sw: 2.2, sh: 1.375, bezel: 0.045, frame: 0.02, depth: 0.065, r: 0.065, sr: 0.03 };
        const gw = dims.sw + dims.bezel * 2, gh = dims.sh + dims.bezel * 2;
        const bw = gw + dims.frame * 2, bh = gh + dims.frame * 2;
        const body = new THREE.Mesh(new RoundedBoxGeometry(bw, bh, dims.depth, 8, dims.r), metal);
        body.castShadow = true;
        g.add(body);
        const glass = new THREE.Mesh(roundedRect(gw, gh, dims.r - dims.frame * 0.6), glassBlack);
        glass.position.z = dims.depth / 2 + 0.0006;
        g.add(glass);
        cover(tex, dims.sw / dims.sh);
        const screen = new THREE.Mesh(roundedRect(dims.sw, dims.sh, dims.sr), new THREE.MeshBasicMaterial({ map: tex, toneMapped: false }));
        screen.position.z = dims.depth / 2 + 0.0012;
        g.add(screen);
        const gloss = new THREE.Mesh(roundedRect(gw, gh, dims.r - dims.frame * 0.6), sheen);
        gloss.position.z = dims.depth / 2 + 0.0018;
        g.add(gloss);
        return g;
      }

      // ---- alfard: its real approval-gate session, typeset crisply ----
      async function terminalTexture() {
        await document.fonts.load('400 32px "JetBrains Mono Variable"');
        await document.fonts.load('700 32px "JetBrains Mono Variable"');
        const W = 2400, H = 1500;
        const c = document.createElement('canvas'); c.width = W; c.height = H;
        const x = c.getContext('2d')!;
        x.fillStyle = '#161618'; x.fillRect(0, 0, W, H);
        // title bar
        x.fillStyle = '#1f1f22'; x.fillRect(0, 0, W, 84);
        ['#3a3a3e', '#3a3a3e', '#3a3a3e'].forEach((col, i) => { x.fillStyle = col; x.beginPath(); x.arc(52 + i * 44, 42, 13, 0, Math.PI * 2); x.fill(); });
        x.fillStyle = '#7d7e84'; x.font = '500 28px "JetBrains Mono Variable"'; x.textAlign = 'center'; x.fillText('alfard', W / 2, 52); x.textAlign = 'left';
        const L = 60; let y = 170; const lh = 54;
        const line = (t: string, col = '#d8d9dc', weight = 400) => { x.font = `${weight} 34px "JetBrains Mono Variable"`; x.fillStyle = col; x.fillText(t, L, y); y += lh; };
        line('~ % alfard run test', '#d8d9dc', 600);
        y += 12;
        line('test  ·  Manage my emails, read, reply and sort through them.', '#8b8c92');
        y += 12;
        line('[mcp] connected to 0/0 server(s)', '#d8d9dc', 600);
        line('connecting integrations...', '#7fb58a');
        line('connected: gdrive, gmail, web search', '#b9bac0');
        y += 12;
        line('you: check my email for an email from slickdash and reply to it', '#f2f2f4', 600);
        y += 26;
        // review box
        const bx = L - 10, by = y - 40, bw = W - 2 * L + 20, bh = 330;
        x.strokeStyle = '#4a4b50'; x.lineWidth = 3; x.strokeRect(bx, by, bw, bh);
        x.fillStyle = '#161618'; x.fillRect(W / 2 - 150, by - 22, 300, 44);
        x.font = '600 30px "JetBrains Mono Variable"'; x.fillStyle = '#e8c37a'; x.textAlign = 'center'; x.fillText('Review required', W / 2, by + 10); x.textAlign = 'left';
        y += 30;
        const kv = (k: string, v: string) => { x.font = '400 32px "JetBrains Mono Variable"'; x.fillStyle = '#8b8c92'; x.fillText(k, L + 20, y); x.fillStyle = '#e6e7ea'; x.fillText(v, L + 280, y); y += 50; };
        kv('Tool:', 'gmail_send_message');
        kv('Arguments:', '{ "to": "slickdash@example.com",');
        kv('', '  "subject": "Re: Hey what\'s up!",');
        kv('', '  "body": "Hi, I\'m doing well, thank you!" }');
        kv('Source:', 'tool_result');
        y += 70;
        x.font = '700 36px "JetBrains Mono Variable"'; x.fillStyle = '#f2f2f4'; x.fillText('Approve? [y/n]: ', L, y);
        x.fillStyle = '#e8c37a'; x.fillText('y', L + x.measureText('Approve? [y/n]: ').width, y); y += lh + 10;
        line('I found an email from slickdash with the subject "Hey what\'s up!"', '#b9bac0');
        line('and sent a reply. Logged to audit.jsonl.', '#b9bac0');
        y += 20;
        x.font = '600 34px "JetBrains Mono Variable"'; x.fillStyle = '#f2f2f4'; x.fillText('you: ', L, y);
        x.fillStyle = '#e6e7ea'; x.fillRect(L + x.measureText('you: ').width + 4, y - 30, 20, 38);
        const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 16;
        return t;
      }

      // ---- Stocky: crop the app out of its demo recording's window ----
      async function stockyTexture(frame: number) {
        const img = await new Promise<HTMLImageElement>((res) => { const i = new Image(); i.onload = () => res(i); i.src = `/_stage/stocky/f${frame}.jpg`; });
        const c = document.createElement('canvas');
        const sx = 81, sy = 57, sw = 797, sh = 498; // inner app area of the recorded window
        c.width = sw * 2; c.height = sh * 2;
        const x = c.getContext('2d')!; x.imageSmoothingQuality = 'high';
        x.drawImage(img, sx, sy, sw, sh, 0, 0, c.width, c.height);
        const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 16;
        return t;
      }

      const camera = new THREE.PerspectiveCamera(22, innerWidth / innerHeight, 0.1, 100);
      camera.position.set(0, 0.3, 6.3);
      camera.lookAt(0, 0.02, 0);

      type Place = { x: number; y: number; z: number; ry: number; rx?: number; rz?: number; s?: number };
      const place = (o: THREE.Object3D, p: Place) => { o.position.set(p.x, p.y, p.z); o.rotation.set(p.rx ?? -0.04, p.ry, p.rz ?? 0); o.scale.setScalar(p.s ?? 1); scene.add(o); };

      const trio: Place[] = [
        { x: -1.02, y: -0.06, z: -0.12, ry: 0.32 },
        { x: 0, y: 0.06, z: 0.22, ry: 0.02 },
        { x: 1.02, y: -0.06, z: -0.12, ry: -0.32 },
      ];

      async function build() {
        if (project === 'mull' || project === 'bite') {
          const texs = await Promise.all(['a', 'b', 'c'].map((k) => loadTex(`/_stage/${project}/${k}.jpg`)));
          const order = project === 'mull' ? [1, 0, 2] : [1, 0, 2];
          trio.forEach((p, i) => place(device('phone', texs[order[i]]), p));
        } else if (project === 'haqdar') {
          const texs = await Promise.all(['a', 'c', 'd'].map((k) => loadTex(`/_stage/haqdar/${k}.jpg`)));
          const pl: Place[] = [
            { x: -1.02, y: -0.06, z: -0.12, ry: 0.32 },
            { x: 0, y: 0.06, z: 0.22, ry: 0.02 },
            { x: 1.02, y: -0.06, z: -0.12, ry: -0.32 },
          ];
          pl.forEach((p, i) => place(device('phone', texs[i]), p));
        } else if (project === 'article') {
          const [desk, mob] = await Promise.all([loadTex('/_stage/article/desktop.jpg'), loadTex('/_stage/article/story_mobile.jpg')]);
          place(device('plate', desk), { x: -0.34, y: 0.12, z: -0.2, ry: 0.2, s: 1.0 });
          place(device('phone', mob), { x: 1.12, y: -0.2, z: 0.42, ry: -0.24, s: 0.9 });
        } else if (project === 'stocky') {
          const [front, back] = await Promise.all([stockyTexture(3), stockyTexture(15)]);
          place(device('plate', back), { x: 0.52, y: 0.4, z: -0.32, ry: -0.24, rx: -0.05, s: 0.95 });
          place(device('plate', front), { x: -0.38, y: -0.22, z: 0.18, ry: -0.2, rx: -0.05, s: 1.0 });
        } else if (project === 'viraj-mahajan') {
          const [desk, mob] = await Promise.all([loadTex('/work/tex/viraj-mahajan/d_home.webp'), loadTex('/work/tex/viraj-mahajan/m_product.webp')]);
          place(device('plate', desk), { x: -0.34, y: 0.12, z: -0.2, ry: 0.2, s: 1.0 });
          place(device('phone', mob), { x: 1.12, y: -0.2, z: 0.42, ry: -0.24, s: 0.9 });
        } else if (project === 'power-policy') {
          const [desk, mob] = await Promise.all([loadTex('/work/tex/power-policy/d_globe.webp'), loadTex('/work/tex/power-policy/m_home.webp')]);
          place(device('plate', desk), { x: -0.34, y: 0.12, z: -0.2, ry: 0.2, s: 1.0 });
          place(device('phone', mob), { x: 1.12, y: -0.2, z: 0.42, ry: -0.24, s: 0.9 });
        } else if (project === 'alfard') {
          const t = await terminalTexture();
          place(device('plate', t), { x: 0, y: 0.02, z: 0, ry: 0.24, rx: -0.06, s: 1.2 });
        }
        renderer.render(scene, camera);
        (window as any).__done = true;
      }
      build();
    </script>
  </body>
</html>
