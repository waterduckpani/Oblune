---
import '../styles/global.css';
import '@fontsource-variable/jetbrains-mono';
import Nav from '../components/Nav.astro';
import Curtain from '../components/Curtain.astro';
import Enter from '../components/Enter.astro';
import RepoDialog from '../components/RepoDialog.astro';
import LiveDialog from '../components/LiveDialog.astro';
import { projects, categoryOf } from '../data/projects';
import { PHASES } from '../lib/phase';

interface Props {
  title: string;
  description: string;
  /** Which page script mounts this view. */
  page: 'home' | 'case';
  /** A still for link previews, relative to the site. */
  image?: string;
  /** What the island says when the page opens. */
  navLabel?: string;
  navLit?: number;
}
const { title, description, page, image = '/work/mull-2400.webp', navLabel, navLit } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Where each link goes, in words: the curtain says it while the next page comes in.
const routes: Record<string, { title: string; kicker: string; lit: number }> = {
  '/': { title: 'Oblune Studio', kicker: 'Selected work, 2026', lit: 0.75 },
  '#top': { title: 'Oblune Studio', kicker: 'Back to the top', lit: 0.75 },
  '#work': { title: 'The work', kicker: `${projects.length} projects, four kinds`, lit: 0.3 },
  '#practice': { title: 'Practice', kicker: 'One person, the whole product', lit: 0.75 },
  '#contact': { title: 'Work with me', kicker: 'Tell me what you are building', lit: 1 },
};
projects.forEach((p, i) => {
  const n = `${String(i + 1).padStart(2, '0')} / ${String(projects.length).padStart(2, '0')}`;
  routes[`/work/${p.slug}`] = { title: p.name, kicker: `Case study · ${categoryOf(p).label} · ${n}`, lit: PHASES[p.phase].lit };
  routes[`#${p.slug}`] = { title: p.name, kicker: `${categoryOf(p).label} · ${n}`, lit: PHASES[p.phase].lit };
});
['apps', 'ai', 'web', 'commerce'].forEach((id) => {
  const c = projects.find((p) => p.category === id);
  if (c) routes[`#cat-${id}`] = { title: categoryOf(c).label, kicker: categoryOf(c).plural, lit: 0.75 };
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ecece9" />
    <meta name="author" content="Bharat Khanna" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oblune Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1500" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      // once you have seen the loader this visit, the home page comes straight in
      try { if (sessionStorage.getItem('oblune:seen')) document.documentElement.classList.add('quick'); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div id="top"></div>
    <canvas class="world" data-world aria-hidden="true" hidden></canvas>
    <div class="grain" aria-hidden="true"></div>
    <div class="cur" data-cur aria-hidden="true">
      <div class="cur__ring" data-cur-ring><i></i></div>
      <div class="cur__dot" data-cur-dot></div>
      <div class="cur__label" data-cur-label><span data-cur-text></span></div>
    </div>
    <Nav label={navLabel} lit={navLit} />

    <div class="view" data-view data-page={page}>
      <slot />
    </div>

    <Curtain />
    <Enter />
    <RepoDialog />
    <LiveDialog />
    <script type="application/json" data-routes set:html={JSON.stringify(routes)} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
